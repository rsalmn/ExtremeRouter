open-sse.old/
.graphifyignore
graphify-out/*

# ExtremeRouter local runtime (never commit user data)
.extremerouter/
*.tgz

# Reports / scratch
UI-AUDIT-REPORT.md

# ZCode AI agent session artifacts (ephemeral — do not commit)
.zcode/

# Local agent work artifacts
.workbuddy-ai/
outputs/
.zcode/

# scratch/temp files (agent temp scripts, logs, etc.)
.tmp-*
*.tmp-*

# machine-specific launcher (kept local)
/brave-extremerouter.cmd

# editor/backup/temp artifacts (never commit)
*.bak
*.orig
*.rej
.freebuff/

# Node SEA build artifacts
dist-sea/
sea-config.json
sea-prep.blob

# capability audit cache
.cache/
